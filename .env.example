# TestForge Monorepo Environment Variables Example
# Copy this file to .env in apps/server or root and fill in your values

# Server Environment (apps/server)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/testforge
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# Client Environment (apps/client)
VITE_API_URL=http://localhost:5000
